@startuml c3-08-lop-tu-lanh
!include _style-c3.iuml
top to bottom direction
skinparam nodesep 28
skinparam ranksep 40
skinparam classAttributeIconSize 0
skinparam wrapWidth 700
skinparam packageStyle folder
hide empty members
hide circle
set separator none

package "pantry/api" as PAPI {
  interface StockIn <<interface>> {
    + AddLots([]NewLot) []uuid.UUID
  }
  interface StockConsumer <<interface>> {
    + ConsumeForMeal(MealCmd) []Allocation
  }
  interface StockQuery <<interface>> {
    + Available(sid, foodIDs, until) Stock
    + SearchLots(sid, LotFilter) []LotView
  }
}

package "pantry/app" as APP {
  class PantryService <<application service>> {
    + AddLot(AddLotCmd) *FoodLot
    + UpdateLot(UpdateLotCmd) UpdateResult
    + Consume(ConsumeCmd) []Allocation
    + Discard(DiscardCmd) StockMovement
    + ConsumeForMeal(MealCmd) []Allocation
    + AddLots([]NewLot) []uuid.UUID
    + Available(sid, foodIDs, until) Stock
    + SearchLots(sid, LotFilter) []LotView
  }
  interface EventPublisher <<interface>> {
    + Publish(...events.Event)
  }
  interface LotRepository <<interface>> {
    + Get(sid, lotID) *FoodLot
    + LockForFEFO(sid, foodIDs, today) []*FoodLot
    + Save(lot *FoodLot)
    + AppendMovements([]StockMovement)
  }
  interface ChangefeedAppender <<interface>> {
    + Append(sid, ...Change) (seq int64)
  }
}

class PgLotRepository <<adapter/postgres>> {
  - q : *sqlcgen.Queries
}


package "pantry/domain" as DOM {
  class FEFOAllocator <<domain service>> {
    + Allocate(lots, need, today) ([]Allocation, Quantity)
  }
  class Allocation <<value object>> {
    + LotID : uuid.UUID
    + Qty : kernel.Quantity
  }
  class FoodLot <<aggregate root>> {
    + ID : uuid.UUID
    + SpaceID : uuid.UUID
    + FoodID : uuid.UUID
    + Initial : kernel.Quantity
    + Remaining : kernel.Quantity
    + Storage : StorageLocation
    + PurchasedOn : time.Time
    + ExpiresOn : time.Time
    + Lifecycle : Lifecycle
    + SourceItemID : *uuid.UUID
    + TotalCost : *kernel.Money
    + Version : int
    + Consume(q, by) (StockMovement, error)
    + Discard(q, reason, by) (StockMovement, error)
    + Adjust(remaining, by) (StockMovement, error)
    + ExpiryState(today, n) ExpiryState
  }
  class StockMovement <<entity>> {
    + LotID : uuid.UUID
    + Kind : MovementKind
    + Qty : kernel.Quantity
    + Reason : *DiscardReason
    + MealEntryID : *uuid.UUID
    + OccurredAt : time.Time
  }
  enum Lifecycle <<enum>> {
    Active
    Consumed
    Discarded
  }
  enum ExpiryState <<enum>> {
    Fresh
    Expiring
    Expired
  }
}

PantryService .up.|> StockIn
PantryService .up.|> StockConsumer
PantryService .up.|> StockQuery
PantryService -down-> "events" EventPublisher
PantryService -down-> "feed" ChangefeedAppender
PantryService -down-> "lots" LotRepository
EventPublisher -[hidden]right- ChangefeedAppender
ChangefeedAppender -[hidden]right- LotRepository
PgLotRepository .up.|> LotRepository
PantryService ..> FEFOAllocator : <<use>>
PgLotRepository -[hidden]down- FEFOAllocator
EventPublisher -[hidden]down- Lifecycle
ChangefeedAppender -[hidden]down- ExpiryState

Lifecycle -[hidden]right- ExpiryState
ExpiryState -[hidden]right- FEFOAllocator
FEFOAllocator ..> Allocation : <<create>>
FEFOAllocator ..> FoodLot
FoodLot *-right- "0..*" StockMovement : movements
StockMovement -[hidden]right- Allocation
FoodLot -up-> Lifecycle
FoodLot .up.> ExpiryState : <<derive>>
@enduml
