@startuml c2-20-tf-k1-gia-dinh-tham-gia
' Task flow K1 – Gia đình cùng tham gia (luồng chính, không vẽ nhánh lỗi)
!include _style.iuml
skinparam wrapWidth 380

start
:[Khách] Nhập họ tên, email, mật khẩu,
đồng ý điều khoản
<size:10><color:#5A6B7B>UC01 · đăng ký</color></size>;
:[Hệ thống] Tạo tài khoản Chờ xác thực,
gửi mã OTP qua email
<size:10><color:#5A6B7B>UC01 · đăng ký (BR01, BR02)</color></size>;
:[Khách] Nhập mã OTP 6 chữ số
<size:10><color:#5A6B7B>UC01 · xác thực OTP, bước 2</color></size>;
:[Hệ thống] Kích hoạt tài khoản,
tạo không gian cá nhân
<size:10><color:#5A6B7B>UC01 · xác thực OTP, bước 3–4 (BR04)</color></size>;
:[Người dùng] Đăng nhập bằng email, mật khẩu
<size:10><color:#5A6B7B>UC02 · đăng nhập</color></size>;
:[Người dùng] Tạo nhóm gia đình,
trở thành Trưởng nhóm
<size:10><color:#5A6B7B>UC05 · tạo nhóm (BR04, BR05)</color></size>;
:[Trưởng nhóm] Mở Gia đình, chọn "Mời thành viên"
<size:10><color:#5A6B7B>UC06 · bước 1</color></size>;
:[Hệ thống] Hiển thị mã mời 8 ký tự, mã QR,
thời gian hiệu lực 48 giờ
<size:10><color:#5A6B7B>UC06 · bước 2–3 (BR06)</color></size>;
:[Trưởng nhóm] Chọn "Chia sẻ", gửi mã cho người thân
<size:10><color:#5A6B7B>UC06 · bước 4–5</color></size>;
:[Người thân] Đăng ký, đăng nhập,
chọn "Tham gia nhóm"
<size:10><color:#5A6B7B>UC01, UC02 · UC06 · bước B1</color></size>;
:[Người thân] Nhập mã mời, nhấn "Tiếp tục"
<size:10><color:#5A6B7B>UC06 · bước B2–B3</color></size>;
:[Hệ thống] Kiểm tra mã, hiển thị tên nhóm,
trưởng nhóm, số thành viên
<size:10><color:#5A6B7B>UC06 · bước B4–B6 (BR04–BR06)</color></size>;
:[Người thân] Nhấn "Tham gia"
<size:10><color:#5A6B7B>UC06 · bước B7</color></size>;
:[Hệ thống] Thêm vào nhóm, chuyển không gian,
báo trưởng nhóm, hiển thị MSG10
<size:10><color:#5A6B7B>UC06 · bước B8</color></size>;
:[Thành viên] Mở Gia đình, xem danh sách thành viên
<size:10><color:#5A6B7B>UC05 · bước 1–2</color></size>;
:[Thành viên] Mở "Cài đặt thông báo",
chọn ngưỡng nhắc N và loại thông báo
<size:10><color:#5A6B7B>UC04 · bước B1–B3</color></size>;
:[Hệ thống] Lưu ngay, hiển thị ví dụ ngày được nhắc
<size:10><color:#5A6B7B>UC04 · bước B4 (BR12)</color></size>;
-[dashed]-> Khi cần thay đổi thành viên;
switch (Thay đổi gì?)
case (A · Xóa thành viên)
  :[Trưởng nhóm] Mở trình đơn của thành viên,
  chọn "Xóa khỏi nhóm", xác nhận (MSG19)
  <size:10><color:#5A6B7B>UC07 · bước 1–3</color></size>;
  :[Hệ thống] Xóa tư cách thành viên,
  trả mặt hàng đang giao về Cần mua
  <size:10><color:#5A6B7B>UC07 · bước 4 (BR07)</color></size>;
case (B · Chuyển quyền)
  :[Trưởng nhóm] Chọn "Chuyển quyền trưởng nhóm"
  trên một thành viên, xác nhận
  <size:10><color:#5A6B7B>UC07 · bước B1–B3</color></size>;
  :[Hệ thống] Đổi vai trò, thu hồi mã mời,
  thông báo cả nhóm
  <size:10><color:#5A6B7B>UC07 · bước B4 (BR05)</color></size>;
case (C · Rời nhóm)
  :[Thành viên] Chọn "Rời nhóm", xác nhận (MSG19)
  <size:10><color:#5A6B7B>UC07 · bước C1–C4</color></size>;
  :[Hệ thống] Xóa tư cách thành viên,
  chuyển về không gian cá nhân, báo trưởng nhóm
  <size:10><color:#5A6B7B>UC07 · bước C5</color></size>;
endswitch
stop
@enduml
