@startuml c2-07-uc-mua-sam
!include _style.iuml
left to right direction

actor "Người dùng" as U
actor "Trưởng nhóm" as L
actor "Dịch vụ\nthông báo đẩy" as PUSH <<hệ thống ngoài>>

rectangle "Quản lý danh sách mua sắm" as B {
  usecase "UC08\nQuản lý danh sách và\nmặt hàng mua sắm" as UC08
  usecase "UC09\nĐánh dấu mặt hàng\nđã mua" as UC09
  usecase "UC10\nBổ sung nguyên liệu còn thiếu\nvào danh sách mua sắm" as UC10
  usecase "UC11\nNhập thực phẩm\nvào tủ lạnh" as UC11
}

U -- UC08
L -- UC08
U -- UC09
U -- UC10
UC09 <.. UC11 : <<extend>>
UC08 -- PUSH
@enduml
