@startuml c2-07-uc-mua-sam
!include _style.iuml
left to right direction

actor "Người dùng" as U
actor "Trưởng nhóm" as L
actor "Dịch vụ\nthông báo đẩy" as PUSH <<hệ thống ngoài>>

rectangle "Quản lý danh sách mua sắm" as B {
  usecase "UC16\nTạo danh sách mua sắm" as UC16
  usecase "UC23\nXem lịch sử mua sắm" as UC23
  usecase "UC17\nCập nhật mặt hàng\ntrong danh sách" as UC17
  usecase "UC20\nĐánh dấu mặt hàng đã mua" as UC20
  usecase "UC22\nSinh danh sách mua sắm\ntừ kế hoạch bữa ăn" as UC22
  usecase "UC19\nPhân công người mua" as UC19
  usecase "UC18\nSao chép danh sách\nmua sắm đã có" as UC18
  usecase "UC21\nChuyển mặt hàng đã mua\nvào tủ lạnh" as UC21
}

U -- UC16
U -- UC23
U -- UC17
U -- UC20
U -- UC22
L -- UC19
UC16 <.. UC18 : <<extend>>
UC23 <.. UC18 : <<extend>>
UC20 <.. UC21 : <<extend>>
UC19 -- PUSH
@enduml
