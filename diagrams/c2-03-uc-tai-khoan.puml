@startuml c2-03-uc-tai-khoan
!include _style.iuml
left to right direction

actor "Khách" as G
actor "Người dùng" as U
actor "Quản trị viên" as A
actor "Dịch vụ\nthư điện tử" as MAIL <<hệ thống ngoài>>

rectangle "Xác thực và quản lý tài khoản" as B {
  usecase "UC01\nĐăng ký và xác thực\ntài khoản" as UC01
  usecase "UC02\nĐăng nhập và đăng xuất" as UC02
  usecase "UC03\nĐặt lại và đổi mật khẩu" as UC03
  usecase "UC04\nQuản lý hồ sơ và\nthiết lập nhắc nhở" as UC04
}

G -- UC01
G -- UC02
G -- UC03
U -- UC02
U -- UC03
U -- UC04
A -- UC02
A -- UC03
A -- UC04
UC01 -- MAIL
UC03 -- MAIL
@enduml
