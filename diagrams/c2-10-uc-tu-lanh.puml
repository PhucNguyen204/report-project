@startuml c2-10-uc-tu-lanh
!include _style.iuml
left to right direction

actor "Người dùng" as U
actor "Bộ lập lịch" as CRON <<hệ thống>>
actor "Dịch vụ\nthông báo đẩy" as PUSH <<hệ thống ngoài>>

rectangle "Quản lý thực phẩm trong tủ lạnh" as B {
  usecase "UC11\nNhập thực phẩm\nvào tủ lạnh" as UC11
  usecase "UC12\nXem và lọc thực phẩm\ntrong tủ lạnh" as UC12
  usecase "UC13\nĐiều chỉnh lô thực phẩm" as UC13
  usecase "UC14\nNhắc thực phẩm\nsắp hết hạn" as UC14
}

U -- UC11
U -- UC12
U -- UC13
CRON -- UC14
UC14 -- PUSH
@enduml
