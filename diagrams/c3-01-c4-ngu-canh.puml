@startuml c3-01-c4-ngu-canh
!$TECHN_FONT_SIZE = 14
!$LEGEND_TITLE_TEXT = "Chú giải"
!include <C4/C4_Context>
skinparam dpi 170
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowFontSize 14
skinparam wrapWidth 210
skinparam nodesep 45
skinparam ranksep 60
HIDE_STEREOTYPE()
LAYOUT_TOP_DOWN()
UpdateElementStyle("person", $legendText="người dùng (tác nhân)")
UpdateElementStyle("system", $legendText="hệ thống đang thiết kế")
UpdateElementStyle("external_system", $legendText="hệ thống bên ngoài")

Person(user, "Người dùng", "Thành viên không gian cá nhân hoặc gia đình")
Person(admin, "Quản trị viên", "Khu vực quản trị trong ứng dụng")

System(sys, "Hệ thống Đi chợ tiện lợi", "Ứng dụng Flutter và máy chủ backend")

System_Ext(fcm, "Firebase Cloud Messaging", "API đẩy HTTP v1 chung")
System_Ext(apns, "Apple Push Notification service", "Đẩy tới thiết bị iOS")
System_Ext(smtp, "Dịch vụ SMTP", "Chuyển tiếp thư điện tử")

Rel_D(user, sys, "Mua sắm, tủ lạnh, công thức, kế hoạch", "HTTPS")
Rel_D(admin, sys, "Quản trị tài khoản, danh mục, tham số", "HTTPS")
Rel_D(sys, fcm, "Gửi thông báo đẩy", "HTTPS")
Rel_D(fcm, apns, "Chuyển tiếp cho iOS")
Rel_U(fcm, user, "Đẩy tới Android")
Rel_U(apns, user, "Đẩy tới iOS")
Rel_D(sys, smtp, "Thư OTP, thư tài khoản", "SMTP/TLS")

Lay_R(user, admin)
Lay_R(fcm, smtp)

SHOW_FLOATING_LEGEND()
Lay_D(admin, LEGEND())
@enduml
