@startuml c2-02-uc-tong-quan
!include _style.iuml
left to right direction
skinparam ranksep 110

actor "Khách" as G
actor "Người dùng" as U
actor "Thành viên nhóm" as M
actor "Trưởng nhóm" as L
actor "Quản trị viên" as A
actor "Bộ lập lịch" as CRON <<hệ thống>>
actor "Dịch vụ\nthư điện tử" as MAIL <<hệ thống ngoài>>
actor "Dịch vụ\nthông báo đẩy" as PUSH <<hệ thống ngoài>>
actor "Cơ sở dữ liệu\nsản phẩm mở" as BAR <<hệ thống ngoài>>

rectangle "Hệ thống “Đi chợ tiện lợi”" as SYSB {
  usecase "Xác thực và quản lý tài khoản\n(UC01–UC08)" as P1
  usecase "Quản lý nhóm gia đình\n(UC09–UC15)" as P2
  usecase "Quản lý danh sách mua sắm\n(UC16–UC23)" as P3
  usecase "Quản lý thực phẩm trong tủ lạnh\n(UC24–UC31)" as P4
  usecase "Quản lý công thức nấu ăn\n(UC32–UC36)" as P5
  usecase "Quản lý kế hoạch bữa ăn\n(UC37–UC41)" as P6
  usecase "Tìm kiếm và phân loại thực phẩm\n(UC42–UC43)" as P7
  usecase "Thống kê báo cáo\n(UC44–UC47)" as P8
  usecase "Quản trị hệ thống\n(UC48–UC53)" as P9
}

G -- P1
U -- P1
U -- P2
U -- P3
U -- P4
U -- P5
U -- P6
U -- P7
U -- P8
P2 -- M
P2 -- L
P3 -- L
CRON -- P4
A -- P9
P1 -- MAIL
P3 -- PUSH
P4 -- PUSH
P4 -- BAR
@enduml
